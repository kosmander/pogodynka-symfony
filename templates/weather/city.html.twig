{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var weather \App\Entity\Weather #}

{% block title %}Hello WeatherController!{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.temperature }}&deg;C, {{ measurement.humidity }}%, {{ measurement.pressure }} hPa, {{ measurement.wind }} km/h, {{ measurement.precipitation }} mm</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
